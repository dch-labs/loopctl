{"tool":"MultiEdit","description":"Edit multiple files atomically. All edits are validated before any writes. Use dry_run=true to preview changes without writing.","input_schema":{"properties":{"dry_run":{"default":false,"description":"Preview changes without writing files","type":"boolean"},"edits":{"description":"Array of edit operations to perform","items":{"properties":{"file_path":{"description":"The path to the file to edit","type":"string"},"new_text":{"description":"The replacement text","type":"string"},"old_text":{"description":"The text to replace","type":"string"}},"required":["file_path","old_text","new_text"],"type":"object"},"maxItems":50,"minItems":1,"type":"array"},"skip_linter":{"default":false,"description":"Skip syntax validation","type":"boolean"}},"required":["edits"],"type":"object"}}